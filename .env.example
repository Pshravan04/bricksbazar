# BricksBazar Environment Variables Configuration Template
# Server & App Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database Configuration (Phase 17)
# MONGODB_URI=mongodb://localhost:27017/bricksbazar
# MONGODB_DB_NAME=bricksbazar

# Authentication / JWT (Phase 11)
# JWT_SECRET=your_jwt_secret_key_change_in_production
# JWT_EXPIRES_IN=7d

# S3 / Cloud Storage for Property & Marketplace Assets (Phase 18)
# S3_ENDPOINT=https://your-region.digitaloceanspaces.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_NAME=bricksbazar-media

# Maps & Location Service (Phase 18)
# NEXT_PUBLIC_MAPBOX_TOKEN=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Communications & Notifications (Phase 18)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMS_OTP_API_KEY=

# Payment Gateway (Phase 18)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Feature Flags
NEXT_PUBLIC_ENABLE_DEMO_DATA=true

